---
import type { Blog } from "../../types/types";
import fs from "node:fs";
import path from "node:path";

interface Props {
  blog: Blog & { content?: string };
  index?: number;
}

const { blog, index = 0 } = Astro.props;

const formattedDate = new Date(blog.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const cardImagePath = `${blog.image.substring(0, blog.image.lastIndexOf("/"))}/hero-card.webp`;
const cardImageExists = fs.existsSync(
  path.join(process.cwd(), "public", cardImagePath)
);
const imageSrc = cardImageExists ? cardImagePath : blog.image;

const searchText = [blog.title, blog.summary, blog.content ?? ""]
  .join(" ")
  .toLowerCase();
---

<article
  class="w-full max-w-3xl mx-auto group"
  data-blog-card
  data-tags={blog.tags.join(",")}
  data-search={searchText}
>
  <a href={`/blog/${blog.route}`} class="block">
    <div class="card-vintage rounded-sm p-6 md:p-8">
      <div class="flex flex-col md:flex-row gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3">
            <time
              class="text-xs font-mono text-ink-muted dark:text-dark-ink-muted uppercase tracking-wider"
              datetime={blog.date}
            >
              {formattedDate}
            </time>
          </div>

          <h3
            class="font-serif text-xl md:text-2xl font-semibold text-ink dark:text-dark-ink mb-3 group-hover:text-sepia dark:group-hover:text-dark-sepia transition-colors"
          >
            {blog.title}
          </h3>

          <p
            class="text-ink-faded dark:text-dark-ink-faded text-sm leading-relaxed mb-4 font-body"
          >
            {blog.summary}
          </p>

          <div class="flex flex-wrap gap-2 mb-4">
            {
              blog.tags.map((tag) => (
                <span class="tag-vintage text-xs">{tag}</span>
              ))
            }
          </div>

          <span
            class="inline-flex items-center gap-2 text-sepia dark:text-dark-sepia text-sm font-medium group-hover:gap-3 transition-all"
          >
            Continue Reading
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        </div>

        <div class="md:w-64 flex-shrink-0">
          <div
            class="overflow-hidden rounded-sm border border-paper-dark dark:border-dark-paper-elevated"
          >
            <img
              src={imageSrc}
              alt={blog.title}
              width="512"
              height="320"
              class="w-full h-40 md:h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading={index < 2 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={index < 2 ? "high" : "auto"}
            />
          </div>
        </div>
      </div>
    </div>
  </a>
</article>
